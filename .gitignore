# ── Documentos de trabajo locales ─────────────
descarga1/
# Solo carpeta "desktop" en la raíz del monorepo. La feature Flutter
# lib/features/desktop/ SÍ se versiona (es parte del build mobile).
/desktop/
*.docx

# ── Sesiones generadas (no versionar) ─────
.nano-sessions/
*.nano

# ── Subproyectos separados / no necesarios para el build ─
# Solo carpeta "dashboard" en la raíz del monorepo. La feature Flutter
# lib/features/dashboard/ SÍ se versiona (es parte del build mobile).
/dashboard/
# Knowledge graphs (raíz y subproyectos): el estado ACTUAL se versiona
# (mapas/gráficas del repo): graph.json + reporte + manifest + labels.
# Cache y snapshots diarios se regeneran — no se versionan.
**/graphify-out/*
!**/graphify-out/graph.json
!**/graphify-out/graph.html
!**/graphify-out/GRAPH_REPORT.md
!**/graphify-out/manifest.json
!**/graphify-out/.graphify_analysis.json
!**/graphify-out/.graphify_labels.json
!**/graphify-out/.graphify_labels.json.sig
!**/graphify-out/.graphify_root
.opencode/
data/
# Local codebase-memory index (binary graph.db.zst) — regenerable, no versionar
.codebase-memory/
# La feature Flutter lib/features/models/ SÍ se versiona (build mobile).
# El patrón global `data/` excluiría su carpeta data/ (datasources, repositorios,
# model_source_registry, model_downloader...). Negación quirúrgica que re-incluye
# SOLO models/data/, sin tocar build_tools/extracted/**/data (extracción de build).
!products/nanoMOBILE/flutter_app/lib/features/models/data/
!products/nanoMOBILE/flutter_app/lib/features/models/data/**
docs/images/
*.history.json
manifest_cpu.json
