{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoAI Desktop",
  "version": "0.1.0",
  "identifier": "dev.nanoai.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NanoAI Studio Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
