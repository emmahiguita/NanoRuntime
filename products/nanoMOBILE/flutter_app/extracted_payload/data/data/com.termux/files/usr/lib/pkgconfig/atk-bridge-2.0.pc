prefix=/data/data/com.termux/files/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: atk-bridge-2.0
Description: ATK/D-Bus Bridge
Version: 2.60.6
Requires.private: atspi-2, atk, dbus-1 >=  1.5, gobject-2.0 >=  2.0.0, glib-2.0 >=  2.67.4, gio-2.0 >=  2.28.0, gmodule-2.0 >=  2.0.0
Libs: -L${libdir} -latk-bridge-2.0
Cflags: -I${includedir}/at-spi2-atk/2.0
