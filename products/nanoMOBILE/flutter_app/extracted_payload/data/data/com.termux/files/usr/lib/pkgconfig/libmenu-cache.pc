prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: libmenu-cache
Description: Cache for freedesktop.org menu spec
Requires: glib-2.0
Version: 1.1.1
Libs: -L${libdir} -lmenu-cache
Cflags: -I${includedir}/menu-cache
