prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: libfm-extra
Description: A glib/gio-based lib used to develop file managers providing some file management utilities.
Requires: glib-2.0 >= 2.22.0
Version: 1.3.2
Libs: -L${libdir} -lfm-extra
Cflags: -I${includedir}
