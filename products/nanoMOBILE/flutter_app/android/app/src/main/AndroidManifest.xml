<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Conexion al motor llama.cpp local (loopback 127.0.0.1) y descarga de modelos -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Consulta factual del estado real de red y WiFi para el agente (@dispositivo) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Lectura de contactos de WhatsApp para el Centro de Notificaciones y Mensajería -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Android 13+: sin este permiso declarado, el sistema suprime las
         notificaciones de la app (POST_NOTIFICATION=ignore) y el usuario ve
         "no permitir". Necesario para avisos locales del agente (T3 notify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Acceso a medios compartidos (Android 13+, runtime grant) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Fallback <= API 32 (READ_MEDIA_* no existe): runtime grant también. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Dictado por voz en el Chat (speech_to_text): runtime grant al primer
         uso del micrófono; sin él el reconocimiento falla con permiso. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- WA-PROD-01: FGS dataSync del runtime de automatización en segundo
         plano: procesa mensajes con la UI cerrada. Vida acotada — idle →
         stopSelf; nunca notificación eterna. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Permiso estándar para programar alarmas en el reloj del sistema sin intervención manual -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- OVERLAY-01: Permite dibujar el búho flotante sobre otras apps (tipo Gemini).
         El usuario concede este permiso explícitamente desde Ajustes → Apps Especiales.
         El canal NanoFloatingChannel verifica Settings.canDrawOverlays() antes de show(). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- A-30: el agente lanza apps Android por packageName (elegido por el
         LLM en runtime — imposible declararlas una a una). Android 11+
         oculta los paquetes no declarados: sin esta visibilidad de apps
         launcher, getLaunchIntentForPackage devuelve null para casi todo.
         Es el caso permitido por Play sin QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- A2: resolver el launcher por defecto (CATEGORY_HOME) para el
             DeviceProfile sin QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
    </queries>

    <!-- extractNativeLibs=true es INTENCIONAL: nanoshell.c usa dlopen() con
         paths absolutos del filesystem. Con false, el linker usa paths internos
         del APK que no son compatibles con dlopen explícito. -->
    <application
        android:label="NanoAI Local"
        android:name=".NanoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/app_settings_description"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:supportsPictureInPicture="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Entrada "Configuración" en Ajustes → Apps → NanoAI Local.
                 El sistema lanza esta actividad con ACTION_APPLICATION_PREFERENCES;
                 MainActivity arranca Flutter en /settings (ver getInitialRoute). -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Worker process for nanoshell: runs fork()+dlopen() in a SEPARATE
             process WITHOUT the GPU/Flutter engine. Fork in the main process
             (with Impeller/Vulkan + Mali driver threads) crashes the GPU
             driver threads (SIGSEGV in mali-compiler/HeapTaskDaemon). The
             worker has no GPU: fork+dlopen is safe there. -->
        <service
            android:name=".NanoshellWorkerService"
            android:exported="false"
            android:process=":nanoshell"
            android:isolatedProcess="false">
        </service>
        <!-- Agente de UI: lee el árbol de accesibilidad y ejecuta gestos para
             el LLM local. El usuario lo activa en Ajustes → Accesibilidad. -->
        <service
            android:name=".services.AgentAccessibilityService"
            android:exported="true"
            android:label="@string/app_settings_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
        <!-- Automatización local de notificaciones. El usuario concede acceso
             explícitamente en Ajustes; el contenido nunca se persiste. -->
        <service
            android:name=".services.NotificationAutomationService"
            android:exported="true"
            android:label="NanoAI — notificaciones"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- WA-PROD-01: runtime headless de automatización (Variante 1):
             drena el inbox durable con la UI cerrada. FGS dataSync de vida
             acotada (Dart pide finish al quedar idle; watchdog 120s), mismo
             proceso main — sin IPC. -->
        <service
            android:name=".automation.AutomationRuntimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- OVERLAY-01: Búho flotante sobre otras apps (tipo Gemini).
             START_NOT_STICKY: no rearranca solo si el sistema lo mata.
             El canal NanoFloatingChannel gestiona show/hide desde Flutter. -->
        <service
            android:name=".services.NanoFloatingService"
            android:exported="false"
            android:stopWithTask="true" />
        <!-- Acción local de la notificación de gobernanza. No es exportada y
             solo reanuda la confirmación firmada que Flutter mantiene activa. -->
        <receiver
            android:name=".channels.AutomationConfirmationActionReceiver"
            android:enabled="true"
            android:exported="false" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller Vulkan falla en algunos GPUs (cancelAndRedraw / pantalla
             congelada en el icono). Skia (OpenGL) es el fallback estable. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- WA-MEDIA-01: FileProvider del catálogo (files/nano/catalog).
             Sirve content:// URIs para ACTION_SEND a WhatsApp (EXTRA_STREAM).
             No exportado: solo la propia app genera las URIs y concede el
             permiso de lectura por intent (FLAG_GRANT_READ_URI_PERMISSION). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
