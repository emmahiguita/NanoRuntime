<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Conexion al motor llama.cpp local (loopback 127.0.0.1) y descarga de modelos -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Acceso a medios compartidos (Android 13+, runtime grant). El visor de
         archivos pcmanfm dentro del escritorio Linux los necesita para montar
         /storage/emulated/0; se solicitan en Ajustes → Escritorio. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Fallback <= API 32 (READ_MEDIA_* no existe): runtime grant también. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Dictado por voz en el Chat (speech_to_text): runtime grant al primer
         uso del micrófono; sin él el reconocimiento falla con permiso. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Sin permisos de foreground service: el worker nanoshell es bind-only
         (exported=false, sin startForeground/startService en todo el código).
         Declararlos sin uso dispara el escrutinio specialUse de Play. -->

    <!-- A-30: el agente lanza apps Android por packageName (elegido por el
         LLM en runtime — imposible declararlas una a una). Android 11+
         oculta los paquetes no declarados: sin esta visibilidad de apps
         launcher, getLaunchIntentForPackage devuelve null para casi todo.
         Es el caso permitido por Play sin QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:label="NanoAI Local"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/app_settings_description"
        android:settingsActivity=".MainActivity"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Entrada "Configuración" en Ajustes → Apps → NanoAI Local.
                 El sistema lanza esta actividad con ACTION_APPLICATION_PREFERENCES;
                 MainActivity arranca Flutter en /settings (ver getInitialRoute). -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Worker process for nanoshell: runs fork()+dlopen() in a SEPARATE
             process WITHOUT the GPU/Flutter engine. Fork in the main process
             (with Impeller/Vulkan + Mali driver threads) crashes the GPU
             driver threads (SIGSEGV in mali-compiler/HeapTaskDaemon). The
             worker has no GPU: fork+dlopen is safe there. -->
        <service
            android:name=".NanoshellWorkerService"
            android:exported="false"
            android:process=":nanoshell"
            android:isolatedProcess="false">
        </service>
        <!-- Agente de UI: lee el árbol de accesibilidad y ejecuta gestos para
             el LLM local. El usuario lo activa en Ajustes → Accesibilidad. -->
        <service
            android:name=".services.AgentAccessibilityService"
            android:exported="true"
            android:label="@string/app_settings_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
