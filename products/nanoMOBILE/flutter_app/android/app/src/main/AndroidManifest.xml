<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Conexion al motor llama.cpp local (loopback 127.0.0.1) y descarga de modelos -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+: sin este permiso declarado, el sistema suprime las
         notificaciones de la app (POST_NOTIFICATION=ignore) y el usuario ve
         "no permitir". Necesario para avisos locales del agente (T3 notify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- A14.5: visibilidad de TODAS las apps instaladas para el inventario del
         agente (SystemInventory -> DeviceProfile / catálogo de apps). Con solo
         QUERIES de launcher, apps que no exponen launcher quedan invisibles y
         el agente "no sabe" de su existencia. Permiso restringido por Play
         (solo apps que lo justifiquen); este proyecto es de desarrollo local
         (debug keystore) y necesita el inventario completo del sistema. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- A14.3: permiso declarativo para el binding con el servicio Shizuku.
         NO concede privilegios por sí solo; declara que la app puede vincularse
         al servicio Shizuku (ShizukuManager). La autorización real se otorga
         explícitamente por el usuario en la app Shizuku, y A14.3 solo la
         reporta de forma factual (checkSelfPermission). Nunca se pide solo. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
    <!-- Acceso a medios compartidos (Android 13+, runtime grant). El visor de
         archivos pcmanfm dentro del escritorio Linux los necesita para montar
         /storage/emulated/0; se solicitan en Ajustes → Escritorio. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Fallback <= API 32 (READ_MEDIA_* no existe): runtime grant también. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Dictado por voz en el Chat (speech_to_text): runtime grant al primer
         uso del micrófono; sin él el reconocimiento falla con permiso. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Scanner de modelos: lee todo /storage/emulated/0 para encontrar GGUF
         y sus rutas sin descargar nada. Grant especial vía Ajustes del
         sistema (ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION), no runtime.
         Sin él el scanner devuelve vacío (honesto) y queda el SAF. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Sin permisos de foreground service: el worker nanoshell es bind-only
         (exported=false, sin startForeground/startService en todo el código).
         Declararlos sin uso dispara el escrutinio specialUse de Play. -->
    <!-- APPFN-01: App Functions (Android 16, API 36). Permiso appop para
         EJECUTAR funciones de apps; en v1 SOLO se declara para que la sonda
         reporte su estado factual (probe, sin ejecución). En Android < 36 el
         sistema ignora el nombre desconocido: declararlo no otorga nada. -->
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS"/>

    <!-- A-30: el agente lanza apps Android por packageName (elegido por el
         LLM en runtime — imposible declararlas una a una). Android 11+
         oculta los paquetes no declarados: sin esta visibilidad de apps
         launcher, getLaunchIntentForPackage devuelve null para casi todo.
         Es el caso permitido por Play sin QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- A2: resolver el launcher por defecto (CATEGORY_HOME) para el
             DeviceProfile sin QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>

    <application
        android:label="NanoAI Local"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/app_settings_description"
        android:settingsActivity=".MainActivity"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Entrada "Configuración" en Ajustes → Apps → NanoAI Local.
                 El sistema lanza esta actividad con ACTION_APPLICATION_PREFERENCES;
                 MainActivity arranca Flutter en /settings (ver getInitialRoute). -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Worker process for nanoshell: runs fork()+dlopen() in a SEPARATE
             process WITHOUT the GPU/Flutter engine. Fork in the main process
             (with Impeller/Vulkan + Mali driver threads) crashes the GPU
             driver threads (SIGSEGV in mali-compiler/HeapTaskDaemon). The
             worker has no GPU: fork+dlopen is safe there. -->
        <service
            android:name=".NanoshellWorkerService"
            android:exported="false"
            android:process=":nanoshell"
            android:isolatedProcess="false">
        </service>
        <!-- Agente de UI: lee el árbol de accesibilidad y ejecuta gestos para
             el LLM local. El usuario lo activa en Ajustes → Accesibilidad. -->
        <service
            android:name=".services.AgentAccessibilityService"
            android:exported="true"
            android:label="@string/app_settings_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
        <!-- Automatización local de notificaciones. El usuario concede acceso
             explícitamente en Ajustes; el contenido nunca se persiste. -->
        <service
            android:name=".services.NotificationAutomationService"
            android:exported="true"
            android:label="NanoAI — notificaciones"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Acción local de la notificación de gobernanza. No es exportada y
             solo reanuda la confirmación firmada que Flutter mantiene activa. -->
        <receiver
            android:name=".channels.AutomationConfirmationActionReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller Vulkan falla en algunos GPUs (cancelAndRedraw / pantalla
             congelada en el icono). Skia (OpenGL) es el fallback estable. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- A14.3: proveedor de binding Shizuku. Declarado por la API oficial
             dev.rikka.shizuku:api. Permite a NanoAI vincularse al servicio
             Shizuku para consultar disponibilidad (pasivo). NO ejecuta nada
             por sí mismo: la ejecución pasa por CandidateAction → governance
             (A14.4). Sin este provider no se establece el binding. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- A14.3: marca la app como cliente Shizuku v3 (binding V3_SUPPORT).
             Pasivo: solo informa al servicio que la app soporta la API v3. -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
        <!-- A14.4: UserService de Shizuku que ejecuta operaciones de paquete
             tipadas con privilegios (forceStop, queryPackage). El intent-filter
             USER_SERVICE permite que Shizuku lo invoque en su proceso. Solo
             packageName validado; nunca shell libre. -->
        <service
            android:name="dev.nanoai.mobile.shizuku.PackageActionService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <intent-filter>
                <action android:name="rikka.shizuku.intent.action.USER_SERVICE" />
            </intent-filter>
        </service>

        <!-- A16: Assistant Role de Android. Servicio LIGERO (sin LLM/ScreenGraph
             residente). El sistema lo mantiene activo cuando Nano se selecciona
             como asistente global; delega la interacción a la sesión. -->
        <service
            android:name="dev.nanoai.mobile.voice.NanoVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name="dev.nanoai.mobile.voice.NanoVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
