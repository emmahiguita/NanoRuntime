<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- El paquete aislado usa el mismo teclado sin cambiar la instalación principal. -->
        <service android:name="dev.nanoai.mobile.input.NanoInputMethodService"
            android:exported="true"
            android:label="Nano Input"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/nano_input_method" />
        </service>
    </application>
</manifest>
