# ============================================================
# NanoAI Runtime — Environment Configuration
# ============================================================
# WARNING: NEVER commit real values. .env is git-ignored.
# Copy this file to .env, then replace placeholders with real keys.
# If you accidentally commit a real key, rotate it IMMEDIATELY at:
#   https://console.anthropic.com/settings/keys
#   https://console.cloud.google.com/apis/credentials
# ============================================================
# Pre-commit hook: scripts/pre-commit-secrets.sh detects key patterns.
# Install: cp scripts/pre-commit-secrets.sh .git/hooks/pre-commit
# ============================================================

# Anthropic API key for Tier 3 cloud inference
# Get yours at: https://console.anthropic.com/
NANO_API_KEY=sk-ant-your-key-here

# OpenAI API key (alternative Tier 3 provider)
# OPENAI_API_KEY=sk-your-key-here

# Gmail API token for email tools
# See: https://developers.google.com/gmail/api/quickstart/
GMAIL_API_TOKEN=your-gmail-token-here

# Log level: trace, debug, info, warn, error
NANO_LOG_LEVEL=info

# Path to models directory (default: ./models)
# NANO_MODELS_PATH=/path/to/models
