# ============================================================
# NanoAI Runtime — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ============================================================

# Anthropic API key for Tier 3 cloud inference
# Get yours at: https://console.anthropic.com/
NANO_API_KEY=sk-ant-your-key-here

# OpenAI API key (alternative Tier 3 provider)
# OPENAI_API_KEY=sk-your-key-here

# Gmail API token for email tools
# See: https://developers.google.com/gmail/api/quickstart/
GMAIL_API_TOKEN=your-gmail-token-here

# Log level: trace, debug, info, warn, error
NANO_LOG_LEVEL=info

# Path to models directory (default: ./models)
# NANO_MODELS_PATH=/path/to/models
