# ============================================================
# NanoAI Runtime — Environment Configuration
# ============================================================
# WARNING: NEVER commit real values. .env is git-ignored.
# Copy this file to .env, then replace placeholders with real keys.
# If you accidentally commit a real key, rotate it IMMEDIATELY at:
#   https://console.anthropic.com/settings/keys
#   https://console.cloud.google.com/apis/credentials
# ============================================================
# Pre-commit hook: scripts/pre-commit-secrets.sh detects key patterns.
# Install: cp scripts/pre-commit-secrets.sh .git/hooks/pre-commit
# ============================================================

# Anthropic API key for Tier 3 cloud inference
# Get yours at: https://console.anthropic.com/
NANO_API_KEY=sk-ant-your-key-here

# OpenAI API key (alternative Tier 3 provider)
# OPENAI_API_KEY=sk-your-key-here

# Gmail API token for email tools
# See: https://developers.google.com/gmail/api/quickstart/
GMAIL_API_TOKEN=your-gmail-token-here

# Log level: trace, debug, info, warn, error
NANO_LOG_LEVEL=info

# Path to models directory (default: ./models)
# NANO_MODELS_PATH=/path/to/models

# ============================================================
# WhatsApp Cloud API template manager (server-side only)
# ============================================================
# Configure these values in the WhatsApp template service environment,
# never in Flutter, source control, logs, or a client-side .env file.
# NANO_WHATSAPP_API_KEY must be a private random key of at least 32 characters.
# Generate it with Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NANO_WHATSAPP_API_KEY=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_WABA_ID=
# META_WHATSAPP_PHONE_NUMBER_ID=  # Solo envío Cloud API.
# META_GRAPH_API_VERSION=vXX.X
